<launch>
  <arg name="input_cloud" default="/cloud_registered_base"/>
  <arg name="fixed_frame" default="odom"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="sensor_frame" default="lidar_link"/>
  <arg name="terrain_frame" default="terrain_sensor"/>
  <arg name="sensor_height" default="0.51"/>
  <arg name="patchwork_config"
       default="$(find go2_terrain)/config/patchworkpp_go2.yaml"/>
  <arg name="guard_config"
       default="$(find go2_terrain)/config/terrain_guard_go2.yaml"/>

  <node pkg="go2_terrain" type="go2_gravity_aligned_cloud_node"
        name="go2_terrain_cloud_adapter" output="screen" required="true">
    <param name="input_topic" value="$(arg input_cloud)"/>
    <param name="output_topic" value="/cloud_registered_terrain"/>
    <param name="fixed_frame" value="$(arg fixed_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="sensor_frame" value="$(arg sensor_frame)"/>
    <param name="terrain_frame" value="$(arg terrain_frame)"/>
    <param name="tf_timeout_sec" value="0.10"/>
    <param name="input_timeout_sec" value="0.60"/>
    <param name="voxel_leaf_size" value="0.08"/>
    <!-- Queue depth one sheds load without aliasing a 10 Hz input to 5 Hz. -->
    <param name="max_publish_rate_hz" value="0.0"/>
  </node>

  <node pkg="patchworkpp" type="go2_patchwork_wrapper_node"
        name="go2_navigation_patchworkpp"
        output="screen" required="true">
    <rosparam command="load" file="$(arg patchwork_config)"/>
    <param name="sensor_height" value="$(arg sensor_height)"/>
    <param name="min_sensor_height" value="0.43"/>
    <param name="max_sensor_height" value="0.59"/>
    <param name="expected_frame" value="$(arg terrain_frame)"/>
    <param name="publish_input" value="false"/>
    <param name="cloud_topic" value="/cloud_registered_terrain"/>
    <remap from="~ground" to="/terrain/patchwork_ground"/>
    <remap from="~nonground" to="/terrain/patchwork_nonground"/>
    <remap from="~cloud" to="/terrain/patchwork_input"/>
  </node>

  <node pkg="go2_terrain" type="go2_terrain_guard_node"
        name="go2_terrain_guard" output="screen" required="true">
    <rosparam command="load" file="$(arg guard_config)"/>
    <param name="expected_frame" value="$(arg terrain_frame)"/>
    <param name="sensor_height" value="$(arg sensor_height)"/>
    <remap from="ground" to="/terrain/patchwork_ground"/>
    <remap from="nonground" to="/terrain/patchwork_nonground"/>
    <remap from="safe_ground" to="/terrain/ground_points"/>
    <remap from="obstacles" to="/terrain/obstacle_points"/>
    <remap from="clearing" to="/terrain/clearing_points"/>
    <remap from="unknown" to="/terrain/unknown_points"/>
    <remap from="diagnostics" to="/terrain/status"/>
    <remap from="healthy" to="/terrain/healthy"/>
  </node>
</launch>
