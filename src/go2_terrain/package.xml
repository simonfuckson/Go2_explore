<?xml version="1.0"?>
<package format="2">
  <name>go2_terrain</name>
  <version>1.0.0</version>
  <description>Gravity-aligned live terrain filtering for GO2 navigation.</description>
  <maintainer email="nvidia@example.com">nvidia</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>boost</depend>
  <depend>costmap_2d</depend>
  <depend>diagnostic_msgs</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>patchworkpp</exec_depend>
  <test_depend>python3-nose</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>rostest</test_depend>

  <export>
    <costmap_2d plugin="${prefix}/costmap_plugins.xml"/>
  </export>
</package>
