<launch>
  <param name="/use_sim_time" value="false"/>
  <rosparam command="load" file="$(find go2_bringup)/config/fast_lio_mid360.yaml"/>
  <param name="pcd_save/pcd_save_en" value="false"/>
  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping"
        output="screen" required="true">
    <remap from="/Odometry" to="/lio/odometry"/>
    <remap from="/cloud_registered" to="/lio/cloud_registered"/>
    <remap from="/cloud_registered_body" to="/lio/cloud_registered_body"/>
    <remap from="/Laser_map" to="/lio/laser_map"/>
    <remap from="/path" to="/lio/path"/>
  </node>
</launch>
